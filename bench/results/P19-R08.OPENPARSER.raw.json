          ],
          "content": "HISTORY"
        },
        {
          "label": "text",
          "order": 5,
          "score": 0.9081851243972778,
          "bbox": [
            68.0,
            424.0,
            1121.0,
            475.0
          ],
          "content": "Admitted through casualty with four days of fever, productive cough and increasing breathlessness. Saturation 88 per cent on room air at presentation. Forty pack-year smoking history, three to four chest infections each winter for the past five years."
        },
        {
          "label": "paragraph_title",
          "order": 6,
          "score": 0.8153795003890991,
          "bbox": [
            70.0,
            483.0,
            205.0,
            505.0
          ],
          "content": "EXAMINATION"
        },
        {
          "label": "text",
          "order": 7,
          "score": 0.8979899287223816,
          "bbox": [
            70.0,
            511.0,
            1121.0,
            561.0
          ],
          "content": "Febrile at 39.5 C, respiratory rate 28, bronchial breathing at the right base with coarse crackles. No signs of cardiac failure. Chest radiograph confirmed right lower lobe consolidation."
        },
        {
          "label": "paragraph_title",
          "order": 8,
          "score": 0.8035120368003845,
          "bbox": [
            70.0,
            571.0,
            147.0,
            592.0
          ],
          "content": "COURSE"
        },
        {
          "label": "text",
          "order": 9,
          "score": 0.9322872757911682,
          "bbox": [
            68.0,
            600.0,
            1122.0,
            673.0
          ],
          "content": "Started on intravenous antibiotics and controlled oxygen. Fever settled by the third day and oxygen was weaned by the fourth. Inflammatory markers fell steadily, as below. Counseled at length on smoking cessation and started on nicotine replacement on the ward, which he accepted for the first time."
        },
