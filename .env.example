# Copy to .env and fill in. NEVER commit .env.
#
# Neon: use the DIRECT endpoint for migrations, not the -pooler one, and keep
# sslmode=require - Neon refuses plaintext connections.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/labidp?sslmode=require

# Signing key for the POC tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-anyone-else-uses-this
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=480

# Where uploaded files land in development. Azure Blob in production.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# A UHID match below this confidence waits for a human instead of attaching.
MATCH_AUTO_ACCEPT=0.95

# Read by the Next.js console.
NEXT_PUBLIC_API_URL=http://localhost:8000
