# Copy to .env and fill in. NEVER commit .env.
#
# Neon: use the DIRECT endpoint for migrations, not the -pooler one, and keep
# sslmode=require - Neon refuses plaintext connections.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/labidp?sslmode=require

# Signing key for the POC tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-anyone-else-uses-this
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=480

# Where uploaded files land in development. Azure Blob in production.
STORAGE_DIR=./storage
# Vercel: 4 - its request limit is 4.5 MB.
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:3000

# development turns authentication OFF and accepts the placeholder JWT_SECRET
# above. Leave it out anywhere real: the default is production, which keeps
# authentication on and refuses to start on a published or short secret.
ENVIRONMENT=development

# Run the docker api and worker against another database - Neon - instead of
# the local one. The DIRECT endpoint (no -pooler in the host) and the database
# that holds this service's schemas. Remove the line and run
# `docker compose up -d api worker` to come back to local.
# LABIDP_DATABASE_URL=postgresql://neondb_owner:...@ep-xxxx.eastus2.azure.neon.tech/labidp?sslmode=require

# Read by the Next.js console.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenParser, the hosted OCR every uploaded document is read with
# (api.openparser.dev, United States, about Rs 0.09 a page). Used by the api's
# POST /documents/read-next and by the worker. Without it nothing is read and
# uploads wait in the queue.
IDP_OPENPARSER_KEY=

# Pass B, the grounded language-model read, used wherever documents are read:
# a document Pass A read no value from has its table and text blocks sent to
# Anthropic, in the United States.
# Header lines - name, UHID, age, referring doctor - and the line after each
# are withheld by app/services/ocr/grounded.py before anything is sent.
# Leave empty and Pass B is off: the worker says so and reads with OpenParser alone.
ANTHROPIC_API_KEY=

# --- The team console (README: "Deploying the team console")
# Every visitor runs as this account, with no sign-in. Allowed in production.
# Empty locally = the console as before: practice 1, editable.
OPEN_ACCESS_TEAM=
# Optional: lets a visitor switch to practice 1, read-only. Run
# db/manual/remove_non_corpus_documents.sql before setting it anywhere public.
OPEN_ACCESS_SAMPLE=
# Warm database connections per process. Vercel: 1. Locally 4.
DB_POOL_MIN=4
