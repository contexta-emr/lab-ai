Table "lab"."analyte_aliases" {
  "id" bigint [pk]
  "analyte_id" bigint [not null]
  "practice_id" bigint
  "alias" varchar(200) [not null]
  "alias_normalised" varchar(200)
  "source" varchar(20) [not null]
  "confidence" numeric(5,4) [not null]
  "is_active" boolean [not null, default: true]
  "is_deleted" boolean [not null, default: false]
  "deleted_at" timestamp
  "deleted_by" bigint
  "created_at" timestamp [not null, default: `now()`]
  "created_by" bigint
  "updated_at" timestamp
  "updated_by" bigint
  "requires_panel_id" bigint
}

Table "lab"."analytes" {
  "id" bigint [pk]
  "code" varchar(40) [not null]
  "panel_id" bigint
  "display_name" varchar(160) [not null]
  "value_type" varchar(10) [not null]
  "default_unit" varchar(40)
  "decimals" smallint [not null]
  "is_derived" boolean [not null, default: false]
  "derivation_note" varchar(255)
  "loinc_code" varchar(20)
  "sort_order" integer [not null]
  "is_active" boolean [not null, default: true]
  "is_deleted" boolean [not null, default: false]
  "deleted_at" timestamp
  "deleted_by" bigint
  "created_at" timestamp [not null, default: `now()`]
  "created_by" bigint
  "updated_at" timestamp
  "updated_by" bigint
}

Table "lab"."document_events" {
  "id" bigint [pk]
  "document_id" bigint [not null]
  "practice_id" bigint [not null]
  "event_type" varchar(40) [not null]
  "from_status" varchar(20)
  "to_status" varchar(20)
  "detail" jsonb
  "actor_user_id" bigint
  "created_at" timestamp [not null, default: `now()`]
}

Table "lab"."documents" {
  "id" bigint [pk]
  "practice_id" bigint [not null]
  "visit_attachment_id" bigint
  "visit_id" bigint
  "patient_id" bigint
  "detected_uhid" varchar(40)
  "detected_uhid_label" varchar(40)
  "detected_patient_name" varchar(255)
  "patient_match_method" varchar(20)
  "patient_match_confidence" numeric(5,4)
  "status" varchar(20) [not null]
  "source" varchar(30) [not null]
  "page_count" integer
  "has_text_layer" boolean
  "ocr_engine" varchar(40)
  "engine_version" varchar(40)
  "extraction_confidence" numeric(5,4)
  "checksum_sha256" char(64)
  "is_synthetic" boolean [not null, default: false]
  "received_at" timestamp [not null, default: `now()`]
  "parsed_at" timestamp
  "reviewed_at" timestamp
  "reviewed_by" bigint
  "error_code" varchar(40)
  "error_detail" text
  "is_deleted" boolean [not null, default: false]
  "deleted_at" timestamp
  "deleted_by" bigint
  "created_at" timestamp [not null, default: `now()`]
  "created_by" bigint
  "updated_at" timestamp
  "updated_by" bigint
  "ocr_attempts" smallint [not null]
  "ocr_error" varchar(500)
  "claimed_at" timestamp
}

Table "lab"."panel_aliases" {
  "id" bigint [pk]
  "panel_id" bigint [not null]
  "practice_id" bigint
  "alias" varchar(200) [not null]
  "alias_normalised" varchar(200)
  "source" varchar(20) [not null]
  "is_active" boolean [not null, default: true]
  "is_deleted" boolean [not null, default: false]
  "deleted_at" timestamp
  "deleted_by" bigint
  "created_at" timestamp [not null, default: `now()`]
  "created_by" bigint
  "updated_at" timestamp
  "updated_by" bigint
}

Table "lab"."panels" {
  "id" bigint [pk]
  "code" varchar(40) [not null]
  "display_name" varchar(120) [not null]
