  "last_seen_at" timestamp [not null, default: `now()`]
  "resolved_analyte_id" bigint
  "resolved_by" bigint
  "resolved_at" timestamp
}

// ====================================================================
// Relationships
// ====================================================================

Ref: "core"."patients"."practice_id" > "core"."practices"."id"
Ref: "core"."users"."practice_id" > "core"."practices"."id"
Ref: "core"."visit_attachments"."patient_id" > "core"."patients"."id"
Ref: "core"."visit_attachments"."practice_id" > "core"."practices"."id"
Ref: "core"."visit_attachments"."uploaded_by" > "core"."users"."id"
Ref: "lab"."analyte_aliases"."analyte_id" > "lab"."analytes"."id"
Ref: "lab"."analyte_aliases"."requires_panel_id" > "lab"."panels"."id"
Ref: "lab"."analytes"."panel_id" > "lab"."panels"."id"
Ref: "lab"."document_events"."document_id" > "lab"."documents"."id"
Ref: "lab"."documents"."visit_attachment_id" > "core"."visit_attachments"."id"
Ref: "lab"."panel_aliases"."panel_id" > "lab"."panels"."id"
Ref: "lab"."reference_ranges"."analyte_id" > "lab"."analytes"."id"
Ref: "lab"."report_notes"."report_id" > "lab"."reports"."id"
Ref: "lab"."report_sections"."panel_id" > "lab"."panels"."id"
Ref: "lab"."report_sections"."report_id" > "lab"."reports"."id"
Ref: "lab"."reports"."document_id" > "lab"."documents"."id"
Ref: "lab"."results"."analyte_id" > "lab"."analytes"."id"
Ref: "lab"."results"."corrected_from_analyte_id" > "lab"."analytes"."id"
Ref: "lab"."results"."document_id" > "lab"."documents"."id"
Ref: "lab"."results"."report_id" > "lab"."reports"."id"
Ref: "lab"."results"."section_id" > "lab"."report_sections"."id"
Ref: "lab"."unmatched_labels"."resolved_analyte_id" > "lab"."analytes"."id"

// ====================================================================
// Logical relationships NOT enforced by a foreign key
// ====================================================================
// These columns carry a real reference but the database does not police it.
// practice_id is the tenancy boundary and is checked only in application code
// (every query filters WHERE practice_id = the caller's). patient_id is
// denormalised onto reports and results so a trend query does not have to walk
// back up to the document. Drawn here so the diagram reflects the real shape;
// remove this block if you only want constraints that actually exist.

Ref: "lab"."documents"."practice_id" > "core"."practices"."id"
Ref: "lab"."documents"."patient_id" > "core"."patients"."id"
Ref: "lab"."documents"."reviewed_by" > "core"."users"."id"
Ref: "lab"."reports"."practice_id" > "core"."practices"."id"
Ref: "lab"."reports"."patient_id" > "core"."patients"."id"
Ref: "lab"."report_sections"."practice_id" > "core"."practices"."id"
Ref: "lab"."report_notes"."practice_id" > "core"."practices"."id"
Ref: "lab"."results"."practice_id" > "core"."practices"."id"
Ref: "lab"."results"."patient_id" > "core"."patients"."id"
Ref: "lab"."results"."reviewed_by" > "core"."users"."id"
Ref: "lab"."document_events"."practice_id" > "core"."practices"."id"
Ref: "lab"."analyte_aliases"."practice_id" > "core"."practices"."id"
Ref: "lab"."panel_aliases"."practice_id" > "core"."practices"."id"
Ref: "lab"."reference_ranges"."practice_id" > "core"."practices"."id"
Ref: "lab"."unmatched_labels"."practice_id" > "core"."practices"."id"
Ref: "lab"."unmatched_labels"."resolved_by" > "core"."users"."id"
