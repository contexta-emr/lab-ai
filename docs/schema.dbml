}

Table "lab"."reports" {
  "id" bigint [pk]
  "document_id" bigint [not null]
  "practice_id" bigint [not null]
  "patient_id" bigint
  "lab_name" varchar(255)
  "lab_address" varchar(500)
  "lab_phone" varchar(40)
